MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
PORT=5050

# Secret for signing wallet session tokens (generate with: openssl rand -hex 32).
# If unset, a random secret is used and users must sign in again after each restart.
AUTH_SECRET=
# Comma-separated origins allowed to call the API cross-origin (not needed with the Vite proxy)
CORS_ORIGIN=

# Optional: external Python FastAPI ML service
# Example endpoint expected: POST {ML_SERVICE_URL}/mrv/infer
ML_SERVICE_URL=http://localhost:8000

# Optional: Pinata (if not set, backend uses deterministic local ipfs:// hash fallback)
PINATA_API_KEY=
PINATA_API_SECRET=

# Optional: real on-chain minting via ethers.js
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
CARBON_CONTRACT_ADDRESS=

# JSON string of ABI containing mintCredit(...)
# Example:
# CARBON_CONTRACT_ABI=[{"inputs":[...],"name":"mintCredit",...}]
CARBON_CONTRACT_ABI=
# Alternate option: path to abi json/artifact file
CARBON_CONTRACT_ABI_PATH=blockchain/artifacts/contracts/BlueCarbonRegistry.sol/BlueCarbonRegistry.json

# Carbon formula tuning
CARBON_BASE_RATE=0.8
CARBON_DEFAULT_TIME_YEARS=1
GEE_PROJECT=
STRICT_REAL_DATA=true
