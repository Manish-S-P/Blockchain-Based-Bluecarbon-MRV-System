# Settings for `docker compose up` (copy to .env). See README "Quick start".

# Google Cloud project registered for Earth Engine (required)
GEE_PROJECT=

# Earth Engine sign-in, choose ONE:
#  a) service-account key file at ml-service/keys/gee-service-account.json (nothing to set here), or
#  b) personal login: run `earthengine authenticate` once on your computer, then point this at
#     the folder it created (Linux/Mac: ~/.config/earthengine, Windows: %UserProfile%\.config\earthengine)
# EARTHENGINE_CREDENTIALS_DIR=~/.config/earthengine

# Optional: real IPFS uploads through Pinata
PINATA_API_KEY=
PINATA_API_SECRET=

# Optional: change host ports if they are already in use
# FRONTEND_PORT=5173
# BACKEND_PORT=5050
# ML_PORT=8000
# CHAIN_PORT=8545
